# Example environment configuration for online PostgreSQL connection
# Copy this file to .env and fill in your actual database credentials.
# .env is included in .gitignore and will never be committed to git.

# Option 1: Full Database Connection URI (Recommended for cloud providers like Neon, Supabase, RDS, Cloud SQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgres://avnadmin:AVNS_Mj4X5zBLra6KtD7Pdin@pg-marvel-cpg-client-data-transformed-tsomorligkh-6931.j.aivencloud.com:18681/defaultdb?sslmode=require
# Option 2: Individual Connection Parameters (Used if DATABASE_URL is not provided)
PGHOST=your-db-host.com
PGPORT=5432
PGDATABASE=marvel_db
PGUSER=postgres
PGPASSWORD=your_password
PGSSLMODE=require
